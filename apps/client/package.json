{
	"name": "client",
	"private": true,
	"version": "1.0.0",
	"description": "report review client",
	"type": "module",
	"scripts": {
		"serve": "vite",
		"svg": "node ./node_modules/@saco/ui/es/svg-cli.mjs -d ../../packages/assets/svg -d ../../packages/assets/svg/country",
		"build:dev": "vue-tsc --noEmit && vite build --mode test",
		"build": "vue-tsc --noEmit && vite build",
		"preview": "vite preview",
		"lint": "eslint . --fix",
		"lint:check": "eslint .",
		"format": "web-lint prettier --write .",
		"stylelint": "web-lint stylelint --fix"
	},
	"dependencies": {
		"echarts": "^6.1.0",
		"vue": "^3.5.42",
		"vue-i18n": "^11.4.10",
		"vue-router": "^5.3.1",
		"workbox-window": "^7.4.1",
		"dayjs": "^1.11.23",
		"qs": "^6.15.3",
		"@saco/ui": "^1.0.0",
		"@saco/rem-plugin": "^1.0.0"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.2",
		"@iconify-json/ep": "^1.2.4",
		"@saco/web-lint": "^1.0.0",
		"@types/node": "^24.13.3",
		"@vitejs/plugin-vue": "^6.0.8",
		"@vitejs/plugin-vue-jsx": "^5.1.6",
		"@vue/tsconfig": "^0.9.1",
		"eslint": "^10.9.1",
		"husky": "^9.1.7",
		"less": "^4.9.0",
		"prettier": "^3.9.6",
		"rollup-plugin-visualizer": "^7.1.1",
		"sass": "^1.103.1",
		"sharp": "^0.35.3",
		"stylelint": "^17.14.1",
		"typescript": "~6.0.3",
		"unplugin-auto-import": "^21.1.0",
		"unplugin-icons": "^23.0.1",
		"unplugin-vue-components": "^32.1.0",
		"vite": "^8.2.2",
		"vite-plugin-compression2": "^2.5.3",
		"vite-plugin-console": "^1.1.1",
		"vite-plugin-html": "^3.2.2",
		"vite-plugin-image-optimizer": "^2.0.3",
		"vite-plugin-pwa": "^1.3.0",
		"vite-plugin-vue-setup-extend": "^0.4.0",
