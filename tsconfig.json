{
	"compilerOptions": {
		"target": "ESNext",
		"useDefineForClassFields": true,
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"strict": true,
		"jsx": "preserve",
		"jsxImportSource": "vue",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"esModuleInterop": true,
		"lib": ["ESNext", "DOM"],
		"skipLibCheck": true,
		"skipDefaultLibCheck": true,
		"noEmit": true,
		"allowJs": true,
		"types": ["vite/client", "@saco/types"]
	},
	"include": [
		"packages/**/*.vue",
		"packages/**/*.ts",
		"packages/**/*.tsx",
		"packages/**/*.d.ts"
	],
	"exclude": [
		"node_modules",
		"packages/vite",
		"packages/i18n/script",
		"packages/theme/script"
	],
	"vueCompilerOptions": {
		"strictTemplates": true,
		"dataAttributes": ["data-*"]
	}
}
